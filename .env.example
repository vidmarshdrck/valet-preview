# Required for sign-in. At least 10 characters. Never commit the real value.
VALET_OWNER_PASSWORD=

# Where SQLite and uploads live. Keep this off the static site.
VALET_DATA_DIR=./data

VALET_HOST=0.0.0.0
VALET_PORT=8787
VALET_SESSION_HOURS=12

# Optional language model. Leave the key empty to use the local butler,
# which talks and remembers but cannot take external actions.
VALET_LLM_API_KEY=
VALET_LLM_BASE_URL=https://api.openai.com/v1
VALET_LLM_MODEL=gpt-4o-mini

# Optional. Defaults to the directory that contains server/.
# VALET_STATIC_ROOT=

# Optional direct TLS. Android install needs HTTPS in production.
# VALET_TLS_KEY=
# VALET_TLS_CERT=
